{
  "name": "@taverns-red/videos",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Opt-in pipeline for ~30-second how-to videos: Playwright captures a scripted walkthrough of the live site, Remotion composes captions, highlights and a generated music bed. Never runs in npm test, the pre-push hook or CI (#2293).",
  "scripts": {
    "capture": "tsx src/cli/capture.ts",
    "render": "tsx src/cli/render.ts",
    "build": "tsx src/cli/build.ts",
    "verify": "tsx src/cli/verify.ts",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest --run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.535",
    "@remotion/renderer": "4.0.535",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.535"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.56.0",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "playwright": "1.64.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
