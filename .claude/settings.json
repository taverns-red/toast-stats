{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run *)",
      "Bash(npm test *)",
      "Bash(npm ci)",
      "Bash(npx vitest *)",
      "Bash(npx tsc *)",
      "Bash(npx prettier *)",
      "Bash(npx eslint *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git fetch *)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git branch *)",
      "Bash(gh api *)"
    ],
    "ask": [
      "Bash(gh api *protection*)",
      "Bash(gh api *rulesets*)",
      "Bash(gh api *collaborators*)",
      "Bash(gh api *actions/secrets*)",
      "Bash(gh api *actions/variables*)",
      "Bash(gh api *hooks*)",
      "Bash(gh api *keys*)",
      "Bash(gh api *-X DELETE*)",
      "Bash(gh api *--method DELETE*)",
      "Bash(gh api *-XDELETE*)",
      "Bash(gh api *-X PUT*)",
      "Bash(gh api *--method PUT*)",
      "Bash(gh api *-XPUT*)",
      "Bash(gh api *-X PATCH*)",
      "Bash(gh api *--method PATCH*)",
      "Bash(gh api *-XPATCH*)",
      "Bash(gh api *-X=*)",
      "Bash(gh api *--method=*)",
      "Bash(gh api *-X put*)",
      "Bash(gh api *-Xput*)",
      "Bash(gh api *--method put*)",
      "Bash(gh api *-X patch*)",
      "Bash(gh api *-Xpatch*)",
      "Bash(gh api *--method patch*)",
      "Bash(gh api *-X delete*)",
      "Bash(gh api *-Xdelete*)",
      "Bash(gh api *--method delete*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/cloud-session-setup.sh",
            "timeout": 600
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/cloud-session-guard.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/cloud-session-guard.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/cloud-session-stop-check.sh",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
