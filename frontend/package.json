{
  "name": "frontend",
  "license": "MIT",
  "private": true,
  "version": "3.23.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 60",
    "test": "vitest --run",
    "test:unit": "vitest --run --project unit",
    "test:integration": "vitest --run --project integration",
    "test:projects:check": "node scripts/check-test-projects.mjs",
    "test:no-page-mounts:check": "node scripts/check-no-page-mounts.mjs",
    "test:watch": "vitest",
    "test:journey:stress": "for i in 1 2 3 4 5; do echo \"=== journey stress run $i/5 ===\" && vitest run src/__tests__/integration/journeys/ --reporter=dot || exit 1; done",
    "typecheck": "tsc --noEmit --skipLibCheck --project tsconfig.json",
    "typecheck:count": "tsc --noEmit --skipLibCheck --project tsconfig.json 2>&1 | grep -E \"error TS[0-9]+\" | wc -l || echo \"0\"",
    "typecheck:errors": "tsc --noEmit --skipLibCheck --project tsconfig.json 2>&1 | grep -E \"error TS[0-9]+\" || echo \"No TypeScript errors found\"",
    "typecheck:prod": "tsc --noEmit --project tsconfig.json",
    "typecheck:test": "tsc --noEmit --project tsconfig.test.json",
    "typecheck:all": "npm run typecheck:prod && npm run typecheck:test",
    "cleanup:test-dirs": "./scripts/cleanup-test-dirs.sh"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-table": "^9.2.4",
    "@taverns-red/analytics-core": "^1.0.0",
    "@taverns-red/shared-contracts": "^1.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.3",
    "recharts": "^3.10.1",
    "tailwindcss": "^4.1.18"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.56.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.0",
    "autoprefixer": "^10.5.6",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "fast-check": "^4.10.0",
    "globals": "^17.12.0",
    "jest-axe": "^11.0.0",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.28",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
