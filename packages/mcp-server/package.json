{
  "name": "@taverns-red/toast-stats-mcp",
  "version": "0.1.3",
  "license": "MIT",
  "type": "module",
  "description": "Thin, local, read-only MCP server over the public Toast Stats snapshot CDN (ADR-008). Exposes the pre-computed snapshot fields as MCP tools over stdio — no computation, no analytics-core.",
  "bin": {
    "toast-stats-mcp": "dist/bin.js"
  },
  "files": [
    "dist/bin.js",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/taverns-red/toast-stats.git",
    "directory": "packages/mcp-server"
  },
  "homepage": "https://github.com/taverns-red/toast-stats/tree/main/packages/mcp-server#readme",
  "bugs": "https://github.com/taverns-red/toast-stats/issues",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "toastmasters",
    "district-statistics"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run build:bin",
    "prepack": "npm run build",
    "build:bin": "esbuild src/bin.ts --bundle --platform=node --format=esm --outfile=dist/bin.js --external:@modelcontextprotocol/sdk --external:zod --log-level=warning",
    "clean": "rm -rf dist",
    "lint": "eslint . --ext .ts --max-warnings 0",
    "test": "vitest --run",
    "test:watch": "vitest",
    "smoke": "npm run build && vitest run src/__tests__/stdio-boot.smoke.test.ts",
    "typecheck": "tsc --noEmit --skipLibCheck",
    "smoke:pack": "bash scripts/pack-smoke.sh"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@taverns-red/shared-contracts": "^1.0.0",
    "esbuild": "^0.28.1",
    "@types/node": "^26.1.2",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.56.0",
    "eslint": "^10.8.0",
    "globals": "^17.8.0",
    "typescript": "^7.0.2",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=22"
  }
}
