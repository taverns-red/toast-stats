{
  "name": "@taverns-red/collector-cli",
  "version": "1.9.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "description": "Standalone CLI tool for collecting Toastmasters dashboard data",
  "bin": {
    "collector-cli": "./bin/collector-cli.js"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "lint": "eslint . --ext .ts --max-warnings 5",
    "test": "vitest --run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit --skipLibCheck"
  },
  "dependencies": {
    "@google-cloud/storage": "^8.1.0",
    "@taverns-red/analytics-core": "^1.0.0",
    "@taverns-red/shared-contracts": "^1.0.0",
    "commander": "^15.0.0",
    "csv-parse": "^7.0.2",
    "dotenv": "^17.4.2",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.5.1",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.56.0",
    "eslint": "^10.10.0",
    "fast-check": "^4.10.0",
    "globals": "^17.12.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
