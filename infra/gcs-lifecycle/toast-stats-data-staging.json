{
  "rule": [
    {
      "action": { "type": "Delete" },
      "condition": { "age": 180, "matchesPrefix": ["runs/"] }
    },
    {
      "action": { "type": "Delete" },
      "condition": { "age": 30, "matchesPrefix": ["_archive/"] }
    },
    {
      "action": { "type": "Delete" },
      "condition": { "isLive": false, "daysSinceNoncurrentTime": 7 }
    },
    {
      "action": { "type": "AbortIncompleteMultipartUpload" },
      "condition": { "age": 7 }
    }
  ]
}
