# Dependencies
node_modules/
.pnp
.pnp.js

# Testing
coverage/

# Production
dist/
build/

# Compiled JS in source directories (shadows .ts files, breaks vitest)
packages/*/src/**/*.js
!packages/*/src/**/*.test.js

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Vite
.vite

# Cache
cache/
downloads/

# Test artifacts - temporary directories only
test-cache*/
test-snapshots/
test-dir/
test-results/
**/test-results/

# Generated reports
typescript-report.json
*-report.json

# Debug files
debug_*.js
debug_*.txt
*-screenshot.png

# Temporary files
*.tmp
*.temp
.tmp/
.tmp-test/
logs
log.txt
logs.json
logs.txt
.firebase/
.npm-cache/

# Agent tooling
.kiro/
.agent/
.routine-tmp/

# Data (local-only)
data/

# Ephemeral per-agent git worktrees (Claude Code `isolation: worktree`).
# Live scratch checkouts with their own node_modules — never committable.
.claude/worktrees/

# Type-sentinel scratch (#1489). snapshotDate.brand.sentinel.test.ts writes
# known-bad snippets into a uniquely-named dir under frontend/src (so their
# relative imports hit the real modules) plus a throwaway tsconfig, runs the
# real tsc over them, and deletes both. A crashed run must not leave anything
# committable behind.
frontend/src/__sentinel__*/
frontend/tsconfig.sentinel.*.json
