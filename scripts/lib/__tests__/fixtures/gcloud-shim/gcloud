#!/usr/bin/env bash
# Stand-in `gcloud` for the store sync/publish script tests (#1722, D10).
#
# Maps gs://<bucket>/<path> onto $SHIM_ROOT/<bucket>/<path>. Object metadata
# (content-encoding, cache-control, content-type) lives in a parallel tree at
# $SHIM_ROOT/.meta/<bucket>/<path> so it never shows up as an object.
#
# Implements only what scripts/pipeline/*.sh and scripts/pull-awards-history.sh
# call: `storage ls <prefix>/**` (or a single-segment `*` glob, or a plain
# `<prefix>/`: one level, sub-prefixes with a trailing slash),
# `storage rsync -r [--checksums-only] <src> <dst>` (--checksums-only skips a
# download whose destination already holds the object's stored bytes: the
# real SDK compares the local file's hash with the object's, #2102),
# `storage cp [--content-type=..] [--cache-control=..] [--custom-metadata=k=v,..]
# [-r] [-Z] <src>... <dst>` (a gs:// source to a gs:// destination is a
# server-side rewrite: bytes and metadata carried as stored — the SDK's
# IntraCloudCopyTask copies the source object's metadata, read in the
# 583.0.0 source, #1763), `storage cat <url>` (the stored bytes: it never
# inflates a gzip object, under any SHIM_DOWNLOAD_DECOMPRESS, #1768),
# `storage rm -r gs://<bucket>/<prefix>/` (every object under the prefix,
# the prune reconcile's delete phase, #1767; a prefix holding no object
# fails like `cat` does on a missing URL), `storage rm <gs://object>...`
# (exact objects, #2232),
# `storage objects list <prefix>**|<glob>|<object> [--soft-deleted] --format=json`,
# and, for the #2239 copy-out (scripts/ops/fac-recovery-2239-copy-out.sh),
# `storage objects describe <url>[#gen] --format=json`,
# `storage restore <url>#<gen> [--if-generation-match=<gen>]` and
# `storage cp [--no-clobber] gs://<b>/<o>#<gen> gs://<b>/<o>`, and
# `storage buckets describe|get-iam-policy gs://<b> --format=json`, served
# from $SHIM_ROOT/.buckets/<b>/{describe,iam}.json (shapes recorded in
# ../gcloud-buckets/); a bucket without the file is a 404.
#
# Generations and soft delete (#2239), only with SHIM_GENERATIONS=1: every
# write gives the object a new generation (`generation=` in its meta), and
# `objects list`/`describe` then report `generation` and `md5_hash`. A
# soft-deleted generation lives at $SHIM_ROOT/.soft/<bucket>/<path>#<gen>
# (meta in .soft-meta/, with its `soft-delete-time=`), never readable: only
# listed (`--soft-deleted`) or restored. A restore copies the soft-deleted
# generation to a new live generation and KEEPS the soft-deleted one (the
# soft-delete docs); it overwrites the live object and soft-deletes it, as
# the JSON API documents (versioning off); its --if-generation-match is a
# precondition on the LIVE object.
# Error texts are the ones Google Cloud SDK 583.0.0 prints (probed read-only
# against the staging bucket, 2026-10-09). The `objects list` JSON keys are a
# subset of the real ones recorded in ../gcloud-objects-list/ (#1731); a test
# pins that, so the shim cannot drift from the SDK (lesson from #1726).
#
# Env:
#   SHIM_ROOT              required: the directory standing in for GCS
#   SHIM_LOG               optional: every invocation's argv is appended here
#   SHIM_FAIL_MATCH        optional: ERE; an invocation whose "$*" matches it
#                          fails with an HTTP 503 (a transport error)
#   SHIM_DOWNLOAD_DECOMPRESS
#                          "1": downloads inflate one layer of a
#                          Content-Encoding: gzip object (gcloud >= 576, the
#                          588 pin). Anything else: bytes as stored (gcloud 568,
#                          the runner's old `latest`) (#1702). `cat` is not a
#                          download: it prints stored bytes either way.
#   SHIM_DOWNLOAD_SKIP     optional: ERE; an rsync download silently skips
#                          objects whose relative path matches (a short read)
#   SHIM_DOWNLOAD_LOG      optional: every object a download reads is
#                          appended as its path (bucket name stripped)
#   SHIM_GENERATIONS       "1": track generations and soft delete (#2239)
#   SHIM_UPLOAD_LOG        optional: every object an upload writes is appended
#                          as `<object path>\t<sha256 of the uploaded,
#                          uncompressed bytes>` (bucket name stripped), so a
#                          test can compare what really went up with what the
#                          run manifest says went up (#1762)
set -euo pipefail

: "${SHIM_ROOT:?SHIM_ROOT must be set}"
[ -n "${SHIM_LOG:-}" ] && printf '%s\n' "$*" >>"${SHIM_LOG}"

if [ "${1:-}" != "storage" ]; then
  echo "gcloud shim: unsupported command: $*" >&2
  exit 2
fi
shift
CMD="${1:-}"
shift

if [ -n "${SHIM_FAIL_MATCH:-}" ] && [[ "${CMD} $*" =~ ${SHIM_FAIL_MATCH} ]]; then
  echo "ERROR: (gcloud.storage.${CMD}) HTTPError 503: Service Unavailable" >&2
  exit 1
fi

is_gs() { [[ "$1" == gs://* ]]; }
bucket_of() { local p="${1#gs://}"; echo "${p%%/*}"; }
local_of() { echo "${SHIM_ROOT}/${1#gs://}"; }
meta_of() { echo "${SHIM_ROOT}/.meta/${1#gs://}"; }

require_bucket() {
  local b
  b="$(bucket_of "$1")"
  if [ ! -d "${SHIM_ROOT}/${b}" ]; then
    echo "ERROR: (gcloud.storage.${CMD}) gs://${b} not found: 404." >&2
    exit 1
  fi
}

gen_enabled() { [ "${SHIM_GENERATIONS:-0}" = "1" ]; }

# The next generation number (monotonic, per shim root).
next_gen() {
  # Real generations are microsecond write times, so a new one is newer than
  # any seeded (pre-2026-10-23) generation: start just after that.
  local f="${SHIM_ROOT}/.gen-counter" n=1793000000000000
  [ -f "${f}" ] && n="$(cat "${f}")"
  n=$((n + 1))
  echo "${n}" >"${f}"
  echo "${n}"
}

# The value of <key>= in a meta file, or nothing.
meta_get() { sed -n "s/^$2=//p" "$1" 2>/dev/null | head -1; }

# Give the object behind <meta file> a new generation (SHIM_GENERATIONS).
stamp_generation() {
  gen_enabled || return 0
  local meta="$1" g
  g="$(next_gen)"
  mkdir -p "$(dirname "${meta}")"
  touch "${meta}"
  grep -v '^generation=' "${meta}" >"${meta}.tmp" || true
  echo "generation=${g}" >>"${meta}.tmp"
  mv "${meta}.tmp" "${meta}"
}

# Base64 MD5 of a stored object's bytes (the API's md5Hash).
md5_b64() { openssl dgst -md5 -binary <"$1" | base64; }

soft_of() { echo "${SHIM_ROOT}/.soft/${1#gs://}#$2"; }
soft_meta_of() { echo "${SHIM_ROOT}/.soft-meta/${1#gs://}#$2"; }

# Download one object to a local file, honouring SHIM_DOWNLOAD_DECOMPRESS.
download_object() {
  local url="$1" dest="$2"
  if [ -n "${SHIM_DOWNLOAD_LOG:-}" ]; then
    local rel="${url#gs://}"
    printf '%s\n' "${rel#*/}" >>"${SHIM_DOWNLOAD_LOG}"
  fi
  mkdir -p "$(dirname "${dest}")"
  if [ "${SHIM_DOWNLOAD_DECOMPRESS:-0}" = "1" ] &&
    grep -qx 'content-encoding=gzip' "$(meta_of "${url}")" 2>/dev/null; then
    gzip -dc <"$(local_of "${url}")" >"${dest}"
  else
    cp "$(local_of "${url}")" "${dest}"
  fi
}

# Upload one local file to an object, recording its metadata. A re-upload
# replaces the metadata wholesale, as a real upload does.
upload_object() {
  local src="$1" url="$2" gz="$3" ctype="$4" cache="$5" custom="${6:-}"
  local obj meta
  obj="$(local_of "${url}")"
  meta="$(meta_of "${url}")"
  mkdir -p "$(dirname "${obj}")" "$(dirname "${meta}")"
  if [ "${gz}" = "1" ]; then
    gzip -c -n <"${src}" >"${obj}"
  else
    cp "${src}" "${obj}"
  fi
  {
    [ "${gz}" = "1" ] && echo 'content-encoding=gzip'
    [ -n "${ctype}" ] && echo "content-type=${ctype}"
    [ -n "${cache}" ] && echo "cache-control=${cache}"
    if [ -n "${custom}" ]; then
      local kv kvs
      IFS=',' read -r -a kvs <<<"${custom}"
      for kv in "${kvs[@]}"; do echo "x-goog-meta-${kv}"; done
    fi
    true
  } >"${meta}"
  stamp_generation "${meta}"
  if [ -n "${SHIM_UPLOAD_LOG:-}" ]; then
    local sum rel="${url#gs://}"
    sum="$({ sha256sum "${src}" 2>/dev/null || shasum -a 256 "${src}"; } | awk '{print $1}')"
    printf '%s\t%s\n' "${rel#*/}" "${sum}" >>"${SHIM_UPLOAD_LOG}"
  fi
}

# One `objects list --format=json` entry, with keys named as gcloud 583
# prints them (custom_fields only when the object has custom metadata).
object_json() {
  local f="$1" b="$2" name="$3" meta line
  local enc="" ctype="" cache="" custom="" gen="" sdt=""
  meta="${4:-${SHIM_ROOT}/.meta/${b}/${name}}"
  if [ -f "${meta}" ]; then
    while IFS= read -r line; do
      case "${line}" in
        content-encoding=*) enc="${line#content-encoding=}" ;;
        content-type=*) ctype="${line#content-type=}" ;;
        cache-control=*) cache="${line#cache-control=}" ;;
        generation=*) gen="${line#generation=}" ;;
        soft-delete-time=*) sdt="${line#soft-delete-time=}" ;;
        x-goog-meta-*)
          line="${line#x-goog-meta-}"
          custom+="${custom:+, }\"${line%%=*}\": \"${line#*=}\""
          ;;
      esac
    done <"${meta}"
  fi
  printf '{"bucket": "%s", "name": "%s", "size": %s' \
    "${b}" "${name}" "$(wc -c <"${f}" | tr -d ' ')"
  [ -n "${cache}" ] && printf ', "cache_control": "%s"' "${cache}"
  [ -n "${enc}" ] && printf ', "content_encoding": "%s"' "${enc}"
  [ -n "${ctype}" ] && printf ', "content_type": "%s"' "${ctype}"
  [ -n "${custom}" ] && printf ', "custom_fields": {%s}' "${custom}"
  if [ -n "${gen}" ]; then
    printf ', "generation": "%s", "md5_hash": "%s"' "${gen}" "$(md5_b64 "${f}")"
  fi
  [ -n "${sdt}" ] && printf ', "soft_delete_time": "%s"' "${sdt}"
  printf '}'
}

case "${CMD}" in
  ls)
    url="${1:?}"
    require_bucket "${url}"
    # A single-segment wildcard (`snapshots/*/all-districts-rankings.json`,
    # the legacy rank-history loop, #1733): expand it as a shell glob.
    if [[ "${url}" != *'**' && "${url}" == *'*'* ]]; then
      found=0
      while IFS= read -r f; do
        [ -f "${f}" ] || continue
        found=1
        echo "gs://${f#"${SHIM_ROOT}/"}"
      done < <(compgen -G "$(local_of "${url}")" | LC_ALL=C sort)
      if [ "${found}" = 0 ]; then
        echo "ERROR: (gcloud.storage.ls) One or more URLs matched no objects." >&2
        exit 1
      fi
      exit 0
    fi
    prefix="${url%\*\*}"
    dir="$(local_of "${prefix}")"
    found=0
    if [[ "${url}" != *'**' && "${url}" == */ ]]; then
      # A plain prefix lists one level: objects as they are, sub-prefixes as
      # `gs://b/p/<name>/` (the shape the workflow's `grep -c '/$'` counts).
      if [ -d "${dir}" ]; then
        while IFS= read -r f; do
          found=1
          if [ -d "${f}" ]; then
            echo "gs://${f#"${SHIM_ROOT}/"}/"
          else
            echo "gs://${f#"${SHIM_ROOT}/"}"
          fi
        done < <(find "${dir}" -mindepth 1 -maxdepth 1 | LC_ALL=C sort)
      fi
    elif [ -d "${dir}" ]; then
      while IFS= read -r f; do
        found=1
        echo "gs://${f#"${SHIM_ROOT}/"}"
      done < <(find "${dir}" -type f | LC_ALL=C sort)
    fi
    if [ "${found}" = 0 ]; then
      echo "ERROR: (gcloud.storage.ls) One or more URLs matched no objects." >&2
      exit 1
    fi
    ;;

  rsync)
    checksums=0
    while [[ "${1:-}" == -* ]]; do
      case "$1" in
        -r) ;;
        --checksums-only) checksums=1 ;;
        *)
          echo "gcloud shim: unsupported rsync flag $1" >&2
          exit 2
          ;;
      esac
      shift
    done
    src="${1:?}"
    dst="${2:?}"
    if is_gs "${src}"; then
      require_bucket "${src}"
      sdir="$(local_of "${src}")"
      if [ ! -d "${sdir}" ] || [ -z "$(find "${sdir}" -type f | head -1)" ]; then
        echo "ERROR: (gcloud.storage.rsync) Did not find existing container at: ${src}" >&2
        exit 1
      fi
      while IFS= read -r f; do
        rel="${f#"${sdir%/}/"}"
        if [ -n "${SHIM_DOWNLOAD_SKIP:-}" ] && [[ "${rel}" =~ ${SHIM_DOWNLOAD_SKIP} ]]; then
          continue
        fi
        if [ "${checksums}" = 1 ] && cmp -s "${f}" "${dst%/}/${rel}"; then
          continue
        fi
        download_object "${src%/}/${rel}" "${dst%/}/${rel}"
      done < <(find "${sdir}" -type f)
    else
      require_bucket "${dst}"
      while IFS= read -r f; do
        rel="${f#"${src%/}/"}"
        upload_object "${f}" "${dst%/}/${rel}" 0 "" ""
      done < <(find "${src}" -type f)
    fi
    ;;

  cp)
    recursive=0 gz=0 ctype="" cache="" custom="" noclobber=0
    args=()
    for a in "$@"; do
      case "${a}" in
        -r) recursive=1 ;;
        -n | --no-clobber) noclobber=1 ;;
        -Z) gz=1 ;;
        --content-type=*) ctype="${a#--content-type=}" ;;
        --cache-control=*) cache="${a#--cache-control=}" ;;
        --custom-metadata=*) custom="${a#--custom-metadata=}" ;;
        -*)
          echo "gcloud shim: unsupported cp flag ${a}" >&2
          exit 2
          ;;
        *) args+=("${a}") ;;
      esac
    done
    dst="${args[${#args[@]}-1]}"
    unset 'args[${#args[@]}-1]'
    for src in "${args[@]}"; do
      if is_gs "${src}"; then
        require_bucket "${src}"
        # A single-segment wildcard (`snapshots/D/district_*.json`, the
        # prior-year pull of the per-date loop, #1742) expands like `ls`.
        matched=()
        if [[ "${src}" == *'#'* ]]; then
          # gs://b/o#<gen>: only the live generation is readable (#2239).
          want="${src##*#}"
          src="${src%#*}"
          if [ -f "$(local_of "${src}")" ] &&
            [ "$(meta_get "$(meta_of "${src}")" generation)" = "${want}" ]; then
            matched=("${src}")
          fi
        elif [[ "${src}" == *'*'* ]]; then
          while IFS= read -r f; do
            [ -f "${f}" ] && matched+=("gs://${f#"${SHIM_ROOT}/"}")
          done < <(compgen -G "$(local_of "${src}")" | LC_ALL=C sort)
        elif [ -f "$(local_of "${src}")" ]; then
          matched=("${src}")
        fi
        if [ "${#matched[@]}" -eq 0 ]; then
          echo "ERROR: (gcloud.storage.cp) The following URLs matched no objects or files:" >&2
          echo "${src}" >&2
          exit 1
        fi
        if is_gs "${dst}"; then
          require_bucket "${dst}"
          for url in "${matched[@]}"; do
            target="${dst}"
            [[ "${dst}" == */ ]] && target="${dst}$(basename "${url}")"
            if [ "${noclobber}" = 1 ] && [ -f "$(local_of "${target}")" ]; then
              echo "Skipping existing destination item (no-clobber): ${target}" >&2
              continue
            fi
            mkdir -p "$(dirname "$(local_of "${target}")")" \
              "$(dirname "$(meta_of "${target}")")"
            cp "$(local_of "${url}")" "$(local_of "${target}")"
            if [ -f "$(meta_of "${url}")" ]; then
              cp "$(meta_of "${url}")" "$(meta_of "${target}")"
            else
              rm -f "$(meta_of "${target}")"
            fi
            stamp_generation "$(meta_of "${target}")"
          done
          continue
        fi
        for url in "${matched[@]}"; do
          if [[ "${dst}" == */ ]] || [ -d "${dst}" ]; then
            download_object "${url}" "${dst%/}/$(basename "${url}")"
          else
            download_object "${url}" "${dst}"
          fi
        done
        continue
      fi
      require_bucket "${dst}"
      # A quoted local wildcard (`-r "/tmp/rank-history-out/*.json"`): gcloud
      # expands it itself; so does the shim.
      if [[ "${src}" == *'*'* ]]; then
        matched=()
        while IFS= read -r f; do matched+=("${f}"); done < <(compgen -G "${src}" | LC_ALL=C sort)
        if [ "${#matched[@]}" -eq 0 ]; then
          echo "ERROR: (gcloud.storage.cp) The following URLs matched no objects or files:" >&2
          echo "${src}" >&2
          exit 1
        fi
        for f in "${matched[@]}"; do
          upload_object "${f}" "${dst%/}/$(basename "${f}")" "${gz}" "${ctype}" "${cache}" "${custom}"
        done
        continue
      fi
      if [ -d "${src}" ]; then
        if [ "${recursive}" != 1 ]; then
          echo "gcloud shim: ${src} is a directory; -r required" >&2
          exit 2
        fi
        base="$(basename "${src}")"
        while IFS= read -r f; do
          rel="${f#"${src%/}/"}"
          upload_object "${f}" "${dst%/}/${base}/${rel}" "${gz}" "${ctype}" "${cache}" "${custom}"
        done < <(find "${src}" -type f)
      elif [[ "${dst}" == */ ]]; then
        upload_object "${src}" "${dst}$(basename "${src}")" "${gz}" "${ctype}" "${cache}" "${custom}"
      else
        upload_object "${src}" "${dst}" "${gz}" "${ctype}" "${cache}" "${custom}"
      fi
    done
    ;;

  cat)
    url="${1:?}"
    require_bucket "${url}"
    if [ ! -f "$(local_of "${url}")" ]; then
      echo "ERROR: (gcloud.storage.cat) The following URLs matched no objects or files:" >&2
      echo "${url}" >&2
      exit 1
    fi
    # The stored bytes, whatever SHIM_DOWNLOAD_DECOMPRESS says: gcloud 588's
    # `cat` does NOT inflate a Content-Encoding: gzip object, only a download
    # does (the staging canary, run 40143638422, #1768). The pipeline cats
    # only identity-encoded objects (v1/, #1852; the education index).
    cat "$(local_of "${url}")"
    ;;

  rm)
    # `rm <gs://b/object>...`: exact objects (a stale district's per-date
    # objects, #2232). Like the SDK, a URL that matches no object fails the
    # call; the others are still removed.
    if [ "${1:-}" != "-r" ]; then
      if [ "$#" -eq 0 ]; then
        echo "gcloud shim: storage rm needs a URL" >&2
        exit 2
      fi
      status=0
      for url in "$@"; do
        if [[ "${url}" != gs://* || "${url}" == *'*'* || "${url}" == */ ]]; then
          echo "gcloud shim: unsupported: storage rm ${url}" >&2
          exit 2
        fi
        require_bucket "${url}"
        if [ ! -f "$(local_of "${url}")" ]; then
          echo "ERROR: (gcloud.storage.rm) The following URLs matched no objects or files:" >&2
          echo "${url}" >&2
          status=1
          continue
        fi
        rm -f "$(local_of "${url}")" "$(meta_of "${url}")"
      done
      exit "${status}"
    fi
    if [ "$#" -ne 2 ]; then
      echo "gcloud shim: unsupported: storage rm $*" >&2
      exit 2
    fi
    url="${2:?}"
    require_bucket "${url}"
    dir="$(local_of "${url%/}")"
    if [ ! -d "${dir}" ] || [ -z "$(find "${dir}" -type f -print -quit)" ]; then
      echo "ERROR: (gcloud.storage.rm) The following URLs matched no objects or files:" >&2
      echo "${url}" >&2
      exit 1
    fi
    rm -rf "${dir}" "$(meta_of "${url%/}")"
    ;;

  objects)
    sub="${1:-}"
    shift || true
    url="" fmt="" soft=0
    for a in "$@"; do
      case "${a}" in
        --format=json) fmt=json ;;
        --soft-deleted) soft=1 ;;
        -*)
          echo "gcloud shim: unsupported: storage objects ${sub} ${a}" >&2
          exit 2
          ;;
        *) url="${a}" ;;
      esac
    done
    if [ "${fmt}" != json ] || [ -z "${url}" ]; then
      echo "gcloud shim: unsupported: storage objects ${sub} $*" >&2
      exit 2
    fi
    b="$(bucket_of "${url}")"
    if [ "${sub}" = describe ]; then
      want=""
      if [[ "${url}" == *'#'* ]]; then
        want="${url##*#}"
        url="${url%#*}"
      fi
      obj="$(local_of "${url}")"
      if [ ! -f "${obj}" ] || { [ -n "${want}" ] &&
        [ "$(meta_get "$(meta_of "${url}")" generation)" != "${want}" ]; }; then
        echo "ERROR: (gcloud.storage.objects.describe) ${url}${want:+#${want}} not found: 404." >&2
        exit 1
      fi
      object_json "${obj}" "${b}" "${url#gs://"${b}"/}"
      printf '\n'
      exit 0
    fi
    if [ "${sub}" != list ]; then
      echo "gcloud shim: unsupported: storage objects ${sub}" >&2
      exit 2
    fi
    if [ ! -d "${SHIM_ROOT}/${b}" ]; then
      # Real 583 behaviour: the error on stderr AND `[]` on stdout, exit 1.
      echo "ERROR: (gcloud.storage.objects.list) gs://${b} not found: 404." >&2
      echo '[]'
      exit 1
    fi
    # The candidate files: a `**` prefix, a single-segment glob or one
    # object; live from the bucket tree, soft-deleted from .soft/ (#2239).
    # A glob or object matching nothing lists `[]`, exit 0 (probed, 583).
    if [ "${soft}" = 1 ]; then
      base="${SHIM_ROOT}/.soft"
    else
      base="${SHIM_ROOT}"
    fi
    files=()
    if [[ "${url}" == *'**' ]]; then
      dir="${base}/${url#gs://}"
      dir="${dir%\*\*}"
      if [ -d "${dir}" ]; then
        while IFS= read -r f; do files+=("${f}"); done < <(find "${dir}" -type f | LC_ALL=C sort)
      fi
    else
      pat="${base}/${url#gs://}"
      [ "${soft}" = 1 ] && pat="${pat}#*"
      while IFS= read -r f; do
        [ -f "${f}" ] && files+=("${f}")
      done < <(compgen -G "${pat}" | LC_ALL=C sort)
    fi
    sep=''
    printf '['
    for f in "${files[@]+"${files[@]}"}"; do
      printf '%s' "${sep}"
      if [ "${soft}" = 1 ]; then
        rel="${f#"${SHIM_ROOT}/.soft/${b}/"}"
        object_json "${f}" "${b}" "${rel%#*}" \
          "${SHIM_ROOT}/.soft-meta/${b}/${rel}"
      else
        object_json "${f}" "${b}" "${f#"${SHIM_ROOT}/${b}/"}"
      fi
      sep=', '
    done
    printf ']\n'
    ;;

  buckets)
    sub="${1:-}"
    url="${2:-}"
    if [ "${3:-}" != "--format=json" ] || [[ "${url}" != gs://* ]]; then
      echo "gcloud shim: unsupported: storage buckets $*" >&2
      exit 2
    fi
    b="$(bucket_of "${url}")"
    case "${sub}" in
      describe) f="${SHIM_ROOT}/.buckets/${b}/describe.json" ;;
      get-iam-policy) f="${SHIM_ROOT}/.buckets/${b}/iam.json" ;;
      *)
        echo "gcloud shim: unsupported: storage buckets ${sub}" >&2
        exit 2
        ;;
    esac
    if [ ! -f "${f}" ]; then
      echo "ERROR: (gcloud.storage.buckets.${sub}) gs://${b} not found: 404." >&2
      exit 1
    fi
    cat "${f}"
    ;;

  restore)
    # `restore gs://b/o#<gen> [--if-generation-match=<live gen>]` (#2239).
    url="" match=""
    for a in "$@"; do
      case "${a}" in
        --if-generation-match=*) match="${a#--if-generation-match=}" ;;
        -*)
          echo "gcloud shim: unsupported restore flag ${a}" >&2
          exit 2
          ;;
        *) url="${a}" ;;
      esac
    done
    if [[ "${url}" != gs://*'#'* ]]; then
      echo "gcloud shim: restore needs gs://<bucket>/<object>#<generation>" >&2
      exit 2
    fi
    require_bucket "${url}"
    gen="${url##*#}"
    obj_url="${url%#*}"
    sfile="$(soft_of "${obj_url}" "${gen}")"
    smeta="$(soft_meta_of "${obj_url}" "${gen}")"
    if [ ! -f "${sfile}" ]; then
      echo "ERROR: (gcloud.storage.restore) ${url} not found: 404." >&2
      exit 1
    fi
    live="$(local_of "${obj_url}")"
    lmeta="$(meta_of "${obj_url}")"
    if [ -n "${match}" ] && { [ ! -f "${live}" ] ||
      [ "$(meta_get "${lmeta}" generation)" != "${match}" ]; }; then
      echo "ERROR: (gcloud.storage.restore) HTTPError 412: At least one of the pre-conditions you specified did not hold." >&2
      exit 1
    fi
    # The live object is overwritten and soft-deleted (versioning off).
    if [ -f "${live}" ]; then
      lgen="$(meta_get "${lmeta}" generation)"
      mkdir -p "$(dirname "$(soft_of "${obj_url}" "${lgen}")")" \
        "$(dirname "$(soft_meta_of "${obj_url}" "${lgen}")")"
      mv "${live}" "$(soft_of "${obj_url}" "${lgen}")"
      { cat "${lmeta}" 2>/dev/null || true
        echo "soft-delete-time=2026-10-24T12:00:00+0000"; } \
        >"$(soft_meta_of "${obj_url}" "${lgen}")"
    fi
    # The soft-deleted generation is COPIED to a new live generation and
    # stays soft-deleted until its retention ends ("Cloud Storage generates
    # a new version of the object ... The original, soft-deleted version
    # remains in the background", docs/storage/docs/soft-delete; #2240 R-2).
    mkdir -p "$(dirname "${live}")" "$(dirname "${lmeta}")"
    cp "${sfile}" "${live}"
    grep -v '^soft-delete-time=' "${smeta}" >"${lmeta}" 2>/dev/null || true
    stamp_generation "${lmeta}"
    ;;

  *)
    echo "gcloud shim: unsupported storage command: ${CMD}" >&2
    exit 2
    ;;
esac
