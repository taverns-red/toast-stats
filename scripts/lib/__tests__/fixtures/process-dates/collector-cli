#!/usr/bin/env bash
# Stand-in `collector-cli` for the process-dates.sh tests (#1742, P3-1).
#
# Reproduces only the on-disk and stdout contract the per-date loop relies
# on (packages/collector-cli/src/cli.ts):
#   transform --date D --force --verbose
#       fails when $CACHE_DIR/raw-csv/D holds no file (no raw, no snapshot);
#       otherwise writes $CACHE_DIR/snapshots/<A>/{metadata.json,district_61.json}
#       where <A> is D, or the date STUB_REMAP maps it to (`D=A,...`): the
#       transform remaps a closing collection onto its month-end (#193).
#       Like the real CLI it also logs on stdout.
#   scrape --date D --transform [--force] --verbose (--districts X | --discover-districts)
#       writes raw-csv/D, then the snapshot as transform does, and prints
#       the summary JSON the daily reads (date, snapshotDate, districts) on
#       stdout, logs on stderr (R4). With STUB_SCRAPE_FAIL it still leaves
#       both behind and exits 1 (PARTIAL_FAILURE).
#   fetch-find-a-club --districts X --include-undistricted --verbose
#       --date D --compare-snapshot-dir S   (the daily's FAC fetch, #430)
#       writes $CACHE_DIR/find-a-club/D/district_<id>.json for each id of X,
#       the recorded raw shape (raw-fac/district_61.json), and prints the
#       real summary JSON (date, outDir, totalDistricts, succeeded, failed,
#       totalClubs, compare, results); exits 1 when a district failed
#       (PARTIAL_FAILURE), as the real CLI does.
#   compute-analytics --date A [--force-analytics] --verbose [--districts X]
#       writes $CACHE_DIR/snapshots/A/analytics/district_61_analytics.json and
#       prints the ComputeAnalyticsResult JSON (with the #1708 store counters)
#       on stdout, logs on stderr (R4). Exits 1 on a failed compute, still
#       printing its JSON, as the real CLI does.
#   merge-find-a-club --fac-dir F --snapshot-dir S --verbose
#       for every district_<id>.json present in BOTH F and S (the real CLI's
#       default discovery), reads the FAC file, which must have the recorded
#       `fetch-find-a-club` shape (a top-level `Clubs` array, see
#       raw-fac/district_61.json), and rewrites the snapshot in place with a
#       `facMergedClubs` marker. Prints the real summary JSON on stdout
#       (totalDistricts, succeeded, failed, totalMatched, ...) and exits 1
#       when a district failed (PARTIAL_FAILURE), as the real CLI does.
#   carry-forward-find-a-club --from-dir P --snapshot-dir S --verbose
#       (#2237) for every district_<id>.json in S with a counterpart in P:
#       a counterpart with a `data.prospectiveClubs` array (the merge's
#       mark, isFacEnriched) is counted in priorEnriched and, unless S's
#       file is already enriched, S's file gains a `facCarriedForward`
#       marker. A counterpart that is not JSON fails the district. Prints
#       the real summary JSON (totalDistricts, priorEnriched, carried,
#       alreadyEnriched, failed) and exits 1 when a district failed.
# Env:
#   CACHE_DIR            required, as for the real CLI
#   STUB_LOG             optional: argv of each call is appended here
#   STUB_REMAP           optional: `D=A[,D=A]` transform date remaps
#   STUB_TRANSFORM_FAIL  optional: ERE; a transform of a matching date fails
#   STUB_SCRAPE_FAIL     optional: ERE; a scrape of a matching date fails
#   STUB_COMPUTE_FAIL    optional: ERE; a compute of a matching date fails
#   STUB_MERGE_FAIL      optional: ERE; a merge into a matching snapshot
#                        date (the --snapshot-dir basename) fails
#   STUB_CARRY_ALREADY   optional: non-empty; every rebuilt district counts
#                        as already enriched, so nothing is carried (#2237)
#   STUB_CARRY_FAIL      optional: ERE; a carry-forward into a matching
#                        snapshot date fails (#2237)
#   STUB_DISK_LOG        optional: before acting, each call appends
#                        `<command>: <path>` for every file under $CACHE_DIR
#                        here — what the real CLI would have read (#1756)
#   STUB_COPY_ON_COMPUTE optional: `<path under CACHE_DIR>=<dest>`; compute
#                        copies that file to <dest>, the bytes it would parse
#   STUB_FAILED_DISTRICTS optional: comma-separated ids the transform
#                        records in metadata.json's failedDistricts, with a
#                        #1671 gap reason in errors[] (#2232)
#   STUB_FAILED_NONGAP   optional: comma-separated ids recorded as failed
#                        with a non-gap reason (#2232)
#   STUB_CLUBS_BY_REGION optional: compute also rewrites
#                        snapshots/A/clubs-by-region/{05,world}.json (#1800)
#   STUB_SCRAPE_EMPTY    optional: ERE; a scrape of a matching date writes
#                        no snapshot and exits 2 (COMPLETE_FAILURE: the
#                        dashboard answered nothing usable, #1669)
#   STUB_FAC_FETCH_FAIL  optional: ERE; a fetch-find-a-club of a matching
#                        date fetches no district (a TI outage) and exits 1
#   STUB_FAC_FETCH_MISS  optional: comma-separated ids the fetch fails for
#                        (a partial fetch, exit 1)
#   STUB_FAC_FETCH_CRASH optional: ERE; a fetch-find-a-club of a matching
#                        date dies before it creates its output folder (an
#                        npx or config failure), prints nothing on stdout
#                        and exits 1 (#2274 N1)
set -euo pipefail

: "${CACHE_DIR:?CACHE_DIR must be set}"
if [ -n "${STUB_LOG:-}" ]; then printf 'collector-cli %s\n' "$*" >>"${STUB_LOG}"; fi
if [ -n "${STUB_DISK_LOG:-}" ] && [ -d "${CACHE_DIR}" ]; then
  (cd "${CACHE_DIR}" && find . -type f | sed "s|^\./|${1:-}: |" | LC_ALL=C sort) \
    >>"${STUB_DISK_LOG}"
fi
if [ "${1:-}" = "compute-analytics" ] && [ -n "${STUB_COPY_ON_COMPUTE:-}" ]; then
  cp "${CACHE_DIR}/${STUB_COPY_ON_COMPUTE%%=*}" "${STUB_COPY_ON_COMPUTE#*=}" || true
fi

CMD="${1:?}"
shift
DATE=""
FAC_DIR=""
FROM_DIR=""
SNAP_DIR=""
DISTRICTS_ARG=""
COMPARE_DIR=""
while [ "$#" -gt 0 ]; do
  case "$1" in
    --date)
      DATE="$2"
      shift 2
      ;;
    --fac-dir)
      FAC_DIR="$2"
      shift 2
      ;;
    --snapshot-dir)
      SNAP_DIR="$2"
      shift 2
      ;;
    --from-dir)
      FROM_DIR="$2"
      shift 2
      ;;
    --districts)
      DISTRICTS_ARG="$2"
      shift 2
      ;;
    --compare-snapshot-dir)
      COMPARE_DIR="$2"
      shift 2
      ;;
    *) shift ;;
  esac
done
if [ "${CMD}" = "carry-forward-find-a-club" ]; then
  : "${FROM_DIR:?--from-dir is required}"
  : "${SNAP_DIR:?--snapshot-dir is required}"
  DATE="$(basename "${SNAP_DIR}")"
fi
if [ "${CMD}" = "merge-find-a-club" ]; then
  : "${FAC_DIR:?--fac-dir is required}"
  : "${SNAP_DIR:?--snapshot-dir is required}"
  DATE="$(basename "${SNAP_DIR}")"
fi
: "${DATE:?--date is required}"

matches() { [ -n "${1:-}" ] && [[ "${DATE}" =~ $1 ]]; }

remapped() {
  local pair map="${STUB_REMAP:-}"
  for pair in ${map//,/ }; do
    if [ "${pair%%=*}" = "${DATE}" ]; then
      echo "${pair#*=}"
      return
    fi
  done
  echo "${DATE}"
}

write_snapshot() {
  local actual dir
  actual="$(remapped)"
  dir="${CACHE_DIR}/snapshots/${actual}"
  mkdir -p "${dir}"
  # The TransformService metadata fields the loop reads (#2232): district
  # 61 succeeds; STUB_FAILED_DISTRICTS are recorded as failed, each with
  # the `<id>: Skipped: ` #1671 gap reason.
  # STUB_FAILED_NONGAP are failed with another reason.
  jq -nc --arg a "${actual}" --arg d "${DATE}" \
    --arg failed "${STUB_FAILED_DISTRICTS:-}" \
    --arg nongap "${STUB_FAILED_NONGAP:-}" '
    ($failed | split(",") | map(select(. != ""))) as $f
    | ($nongap | split(",") | map(select(. != ""))) as $n
    | {snapshotDate: $a, sourceDate: $d,
       successfulDistricts: ["61"],
       failedDistricts: ($f + $n),
       errors: (($f | map("\(.): Skipped: club-performance.csv is not a CSV, a gap, not zero clubs (#1671)"))
         + ($n | map("\(.): transform failed: ECONNRESET")))}' \
    >"${dir}/metadata.json"
  printf '{"districtId":"61","asOf":"%s"}\n' "${actual}" >"${dir}/district_61.json"
}

case "${CMD}" in
  scrape)
    # scrape --date D --transform --force --verbose --districts X: collects
    # raw-csv/D from the dashboard, then transforms it. A failure part way
    # (STUB_SCRAPE_FAIL) leaves what it had written, as a crash would.
    echo "[INFO] scrape ${DATE}" >&2
    if matches "${STUB_SCRAPE_EMPTY:-}"; then
      echo "[ERROR] scrape: the dashboard returned nothing for ${DATE}" >&2
      printf '{"date":"%s","districts":{"succeeded":0,"failed":1}}\n' "${DATE}"
      exit 2
    fi
    mkdir -p "${CACHE_DIR}/raw-csv/${DATE}/district-61"
    printf 'Club,Goals\n' >"${CACHE_DIR}/raw-csv/${DATE}/district-61/club-performance.csv"
    write_snapshot
    actual="$(remapped)"
    if matches "${STUB_SCRAPE_FAIL:-}"; then
      echo "[ERROR] scrape failed for ${DATE}" >&2
      printf '{"date":"%s","snapshotDate":"%s","districts":{"succeeded":1,"failed":1}}\n' "${DATE}" "${actual}"
      exit 1
    fi
    printf '{"date":"%s","snapshotDate":"%s","districts":{"succeeded":1,"failed":0}}\n' "${DATE}" "${actual}"
    ;;
  fetch-find-a-club)
    : "${DISTRICTS_ARG:?--districts is required}"
    : "${COMPARE_DIR:?--compare-snapshot-dir is required}"
    if matches "${STUB_FAC_FETCH_CRASH:-}"; then
      echo "Error: Cannot find module 'collector-cli'" >&2
      exit 1
    fi
    out="${CACHE_DIR}/find-a-club/${DATE}"
    mkdir -p "${out}"
    fixture="$(dirname "${BASH_SOURCE[0]}")/raw-fac/district_61.json"
    ok=0 failed=0 clubs=0 results=""
    for id in ${DISTRICTS_ARG//,/ }; do
      if matches "${STUB_FAC_FETCH_FAIL:-}" || [[ ",${STUB_FAC_FETCH_MISS:-}," == *",${id},"* ]]; then
        echo "[ERROR] district ${id}: fetch failed" >&2
        failed=$((failed + 1))
        results+="${results:+,}{\"districtId\":\"${id}\",\"clubCount\":0,\"ok\":false,\"error\":\"HTTP 503\"}"
        continue
      fi
      jq --arg id "${id}" '.district = $id' "${fixture}" >"${out}/district_${id}.json"
      n="$(jq '.Clubs | length' "${fixture}")"
      ok=$((ok + 1))
      clubs=$((clubs + n))
      results+="${results:+,}{\"districtId\":\"${id}\",\"clubCount\":${n},\"ok\":true,\"snapshotClubCount\":1,\"extraInFac\":$((n - 1))}"
    done
    printf '{"date":"%s","outDir":"%s","totalDistricts":%d,"succeeded":%d,"failed":%d,"totalClubs":%d,"results":[%s]}\n' \
      "${DATE}" "${out}" "$((ok + failed))" "${ok}" "${failed}" "${clubs}" "${results}"
    [ "${failed}" -eq 0 ] || exit 1
    ;;
  transform)
    echo "[INFO] transform ${DATE}"
    raw="${CACHE_DIR}/raw-csv/${DATE}"
    if [ -z "$(find "${raw}" -type f 2>/dev/null | head -1)" ]; then
      echo "[ERROR] no raw CSVs in ${raw}" >&2
      exit 1
    fi
    if matches "${STUB_TRANSFORM_FAIL:-}"; then
      echo "[ERROR] transform failed for ${DATE}" >&2
      exit 1
    fi
    write_snapshot
    ;;
  compute-analytics)
    dir="${CACHE_DIR}/snapshots/${DATE}"
    status=0
    ok=true
    if [ ! -d "${dir}" ] || matches "${STUB_COMPUTE_FAIL:-}"; then
      status=1
      ok=false
    else
      mkdir -p "${dir}/analytics"
      printf '{"districtId":"61","date":"%s"}\n' "${DATE}" \
        >"${dir}/analytics/district_61_analytics.json"
      if [ -n "${STUB_CLUBS_BY_REGION:-}" ]; then
        # The real CLI rewrites clubs-by-region/ whole (#1800).
        rm -rf "${dir}/clubs-by-region"
        mkdir -p "${dir}/clubs-by-region"
        printf '{"date":"%s"}\n' "${DATE}" >"${dir}/clubs-by-region/05.json"
        printf '{"date":"%s","world":true}\n' "${DATE}" \
          >"${dir}/clubs-by-region/world.json"
      fi
    fi
    echo "[INFO] computing ${DATE}" >&2
    printf '{"success":%s,"date":"%s","requestedDate":"%s","districtsSucceeded":["61"],"districtsFailed":[],"timeSeries":{"written":1,"failed":0},"clubTrends":{"written":2,"failed":0},"clubRace":{"written":1,"failed":0}}\n' \
      "${ok}" "${DATE}" "${DATE}"
    exit "${status}"
    ;;
  merge-find-a-club)
    total=0 ok=0 failed=0 matched=0
    for fac in "${FAC_DIR}"/district_*.json; do
      [ -f "${fac}" ] || continue
      id="$(basename "${fac}" .json)"
      snap="${SNAP_DIR}/${id}.json"
      [ -f "${snap}" ] || continue
      total=$((total + 1))
      if matches "${STUB_MERGE_FAIL:-}" ||
        ! clubs="$(jq -e '.Clubs | arrays | length' "${fac}")"; then
        echo "[ERROR] ${id}: merge failed" >&2
        failed=$((failed + 1))
        continue
      fi
      jq -c --argjson n "${clubs}" '. + {facMergedClubs: $n}' "${snap}" >"${snap}.tmp"
      mv "${snap}.tmp" "${snap}"
      echo "[INFO] ${id}: matched=${clubs}" >&2
      ok=$((ok + 1))
      matched=$((matched + clubs))
    done
    printf '{"totalDistricts":%d,"succeeded":%d,"failed":%d,"totalMatched":%d,"totalSnapshotOnly":0,"totalFacOnly":0,"results":[]}\n' \
      "${total}" "${ok}" "${failed}" "${matched}"
    [ "${failed}" -eq 0 ] || exit 1
    ;;
  carry-forward-find-a-club)
    total=0 prior_enriched=0 carried=0 already=0 failed=0
    for snap in "${SNAP_DIR}"/district_*.json; do
      [ -f "${snap}" ] || continue
      prior="${FROM_DIR}/$(basename "${snap}")"
      [ -f "${prior}" ] || continue
      total=$((total + 1))
      if matches "${STUB_CARRY_FAIL:-}" || ! jq -e . "${prior}" >/dev/null 2>&1; then
        echo "[ERROR] $(basename "${snap}"): carry-forward failed" >&2
        failed=$((failed + 1))
        continue
      fi
      jq -e '.data.prospectiveClubs | arrays' "${prior}" >/dev/null || continue
      prior_enriched=$((prior_enriched + 1))
      if [ -n "${STUB_CARRY_ALREADY:-}" ] || jq -e '(.data.prospectiveClubs | arrays) or .facCarriedForward or .facMergedClubs' "${snap}" >/dev/null; then
        already=$((already + 1))
        continue
      fi
      jq -c '. + {facCarriedForward: true}' "${snap}" >"${snap}.tmp"
      mv "${snap}.tmp" "${snap}"
      carried=$((carried + 1))
    done
    printf '{"totalDistricts":%d,"priorEnriched":%d,"carried":%d,"alreadyEnriched":%d,"failed":%d,"results":[]}\n' \
      "${total}" "${prior_enriched}" "${carried}" "${already}" "${failed}"
    [ "${failed}" -eq 0 ] || exit 1
    ;;
  *)
    echo "collector-cli stub: unsupported command ${CMD}" >&2
    exit 2
    ;;
esac
